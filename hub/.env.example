# ─── Base de datos ───────────────────────────────────────────────────
# Cadena de conexión de PostgreSQL (Neon). El worker y las rutas SSE
# requieren conexión TCP: LISTEN/NOTIFY no existe sobre el driver HTTP.
DATABASE_URL=postgresql://usuario:clave@host/basedatos?sslmode=require
PG_POOL_MAX=5

# ─── Cifrado en reposo ───────────────────────────────────────────────
# 32 bytes en base64. Protege el refresh_token de Google con AES-256-GCM.
# Generar con:  openssl rand -base64 32
ENCRYPTION_KEY=

# Sal para las huellas de IP. No es un secreto criptográfico, pero
# impide correlacionar huellas entre despliegues distintos.
IP_HASH_SALT=

# ─── Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Identificadores EXACTOS, sin sufijo de fecha.
# Alternativas por coste: claude-sonnet-5 ($2/$10), claude-haiku-4-5 ($1/$5).
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_COMPACTION_MODEL=claude-haiku-4-5

# ─── Almacenamiento de objetos ───────────────────────────────────────
# Replit Object Storage o cualquier almacén compatible con S3 (R2).
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto

# ─── Google Calendar ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://midominio.replit.app/api/auth/google/callback

# ─── Aplicación ──────────────────────────────────────────────────────
APP_URL=https://midominio.replit.app
APP_TIMEZONE=America/Bogota
ALLOW_SIGNUP=false

# Secreto para invocar trabajos por HTTP (POST /api/jobs/{name}).
# Sólo necesario si se opta por despliegues programados en lugar del
# worker residente (ARQUITECTURA.md §13.4).
CRON_SECRET=
